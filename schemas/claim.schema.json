{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELITE Claim",
  "description": "An attributed proposition linked to observations; the schema does not establish truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "proposition",
    "evidence_refs",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "proposition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "supported",
            "partially_supported",
            "contradicted",
            "inconclusive",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
