{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELITE Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "subject_ref",
    "decision",
    "reviewed_at",
    "reviewer_type",
    "rationale"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "quarantine",
        "request_more_evidence",
        "defer"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_type": {
      "enum": [
        "human",
        "automated_policy"
      ]
    },
    "reviewer_id": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string"
    }
  }
}
