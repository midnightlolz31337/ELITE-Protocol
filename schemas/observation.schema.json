{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELITE Observation",
  "description": "A source-attributed observation; not itself a verified claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source",
    "observed_at",
    "content",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "uri"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "publisher": {
          "type": "string",
          "maxLength": 256
        },
        "license": {
          "type": "string",
          "maxLength": 256
        },
        "authorization_ref": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "text"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 200000
        },
        "language": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "scope",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "const": "content.text.utf8"
        }
      },
      "description": "SHA-256 digest of the exact UTF-8 bytes of content.text after JSON decoding; not the original serialized source-file bytes."
    },
    "limitations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_id",
        "record_id",
        "source_record_line",
        "record_digest"
      ],
      "properties": {
        "import_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_record_line": {
          "type": "integer",
          "minimum": 1
        },
        "record_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "scope",
            "digest",
            "size_bytes"
          ],
          "properties": {
            "algorithm": {
              "const": "sha-256"
            },
            "scope": {
              "enum": [
                "ingestion.jsonl.line.bytes",
                "ingestion.csv.normalized_row.utf8"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "description": "Digest metadata from the originating Ingestion Core envelope; distinct from integrity.digest over decoded Observation content.text."
    }
  }
}
